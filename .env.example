# Reference only: atlant does not automatically load workspace .env files.
# Export selected settings in your shell before starting a new local service.
CODEX_GATEWAY_MODEL=gpt-5.6-sol
ATLANT_WORKERS=6
CODEX_GATEWAY_TIMEOUT_SECONDS=600

# Optional: absolute private directory OUTSIDE the target workspace.
# Default: ${XDG_STATE_HOME:-~/.local/state}/atlant
# ATLANT_STATE_DIR=/absolute/path/to/private/atlant-state

# For legacy main.py / direct SDK use with an independently managed gateway:
# ATLANT_POLICY_MODE=full  # full | lite | off; service API has per-run policy_mode.
# CODEX_GATEWAY_URL=http://127.0.0.1:8765
# CODEX_GATEWAY_TOKEN=   # Supply privately through the environment.
# CODEX_GATEWAY_WORKSPACE=/absolute/path/to/project
# CODEX_GATEWAY_SANDBOX=read-only

# Optional legacy providers, unused by the normal Codex route:
# GEMINI_API_KEY=
# LLM7_TOKEN=
# POLLINATIONS_TOKEN=
